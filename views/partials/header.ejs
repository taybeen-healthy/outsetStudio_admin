<header class="top-header">
  <div class="header-left">
    <span class="header-edge-line"></span>
    <span class="header-status-badge">
      <span class="status-square"></span>
      STUDIO ACTIVE • <%= user.location.toUpperCase() %>
    </span>
  </div>
  <div class="header-right">
    <div class="search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search records, projects, clients...">
    </div>
    <button class="notification-btn">
      <i class="fa-regular fa-bell"></i>
    </button>
    <div class="header-avatar"><%= user.initials %></div>
  </div>
</header>
