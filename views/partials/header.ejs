<header class="top-header">
  <div class="header-left">
    <span class="header-location"><%= user.location %> Admin</span>
    <span class="header-divider">•</span>
    <span class="header-status"><span class="status-dot"></span> STUDIO ACTIVE • <%= user.location.toUpperCase() %></span>
  </div>
  <div class="header-right">
    <div class="search-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search records, projects, clients...">
    </div>
    <button class="notification-btn">
      <i class="fa-regular fa-bell"></i>
    </button>
    <div class="header-avatar"><%= user.initials %></div>
  </div>
</header>
