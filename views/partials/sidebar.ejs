<aside class="sidebar">
  <div class="sidebar-top">
    <div class="sidebar-logo">
      <span class="logo-outset">OUTSET</span><span class="logo-studio">STUDIO</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>">
        <i class="fa-solid fa-grip"></i>
        <span>Dashboard</span>
      </a>
      <a href="/admin/projects" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'projects') ? 'active' : '' %>">
        <i class="fa-solid fa-building"></i>
        <span>Projects</span>
        <span class="nav-count"><%= (typeof navCounts !== 'undefined' && navCounts) ? String(navCounts.projects).padStart(2, '0') : '' %></span>
      </a>
      <a href="/admin/reviews" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'reviews') ? 'active' : '' %>">
        <i class="fa-regular fa-comment-dots"></i>
        <span>Reviews</span>
      </a>
      <a href="/admin/enquiries" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'enquiries') ? 'active' : '' %>">
        <i class="fa-regular fa-envelope"></i>
        <span>Enquiries</span>
        <span class="nav-count"><%= (typeof navCounts !== 'undefined' && navCounts) ? String(navCounts.enquiries).padStart(2, '0') : '' %></span>
      </a>
      <a href="/admin/vendors" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'vendors') ? 'active' : '' %>">
        <i class="fa-solid fa-people-group"></i>
        <span>Vendor Registrations</span>
      </a>
      <a href="/admin/settings" class="nav-item <%= (typeof activePage !== 'undefined' && activePage === 'settings') ? 'active' : '' %>">
        <i class="fa-solid fa-sliders"></i>
        <span>Settings</span>
      </a>
    </nav>
  </div>
  <div class="sidebar-bottom">
    <div class="sidebar-user">
      <div class="user-avatar"><%= (typeof user !== 'undefined' && user) ? user.initials : 'AD' %></div>
      <div class="user-info">
        <div class="user-name"><%= (typeof user !== 'undefined' && user) ? user.name : 'Admin' %></div>
        <div class="user-role"><%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Administrator' %><%= (typeof user !== 'undefined' && user && user.location) ? ', ' + user.location : '' %></div>
      </div>
    </div>
    <a href="/logout" class="signout-btn">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span>Sign Out</span>
    </a>
  </div>
</aside>
