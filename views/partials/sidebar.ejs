<aside class="sidebar">
  <div class="sidebar-top">
    <div class="sidebar-logo">
      <span class="logo-outset">OUTSET</span><span class="logo-studio">STUDIO</span>
    </div>
    <nav class="sidebar-nav">
      <a href="/admin/dashboard" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
        <i class="fa-solid fa-grip"></i>
        <span>Dashboard</span>
      </a>
      <a href="/admin/projects" class="nav-item <%= activePage === 'projects' ? 'active' : '' %>">
        <i class="fa-solid fa-building"></i>
        <span>Projects</span>
      </a>
      <a href="/admin/reviews" class="nav-item <%= activePage === 'reviews' ? 'active' : '' %>">
        <i class="fa-regular fa-comment-dots"></i>
        <span>Reviews</span>
      </a>
      <a href="/admin/enquiries" class="nav-item <%= activePage === 'enquiries' ? 'active' : '' %>">
        <i class="fa-regular fa-envelope"></i>
        <span>Enquiries</span>
      </a>
      <a href="/admin/vendors" class="nav-item <%= activePage === 'vendors' ? 'active' : '' %>">
        <i class="fa-solid fa-people-group"></i>
        <span>Vendor Registrations</span>
      </a>
      <a href="/admin/settings" class="nav-item <%= activePage === 'settings' ? 'active' : '' %>">
        <i class="fa-solid fa-sliders"></i>
        <span>Settings</span>
      </a>
    </nav>
  </div>
  <div class="sidebar-bottom">
    <div class="sidebar-user">
      <div class="user-avatar"><%= user.initials %></div>
      <div class="user-info">
        <div class="user-name"><%= user.name %></div>
        <div class="user-role"><%= user.role %>, <%= user.location %></div>
      </div>
    </div>
    <a href="/auth/logout" class="signout-btn">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span>Sign Out</span>
    </a>
  </div>
</aside>
