<div class="login-wrapper">
  <div class="login-card">
    <div class="login-logo">
      <span class="logo-outset">OUTSET</span><span class="logo-studio">STUDIO</span>
    </div>
    <h2 class="login-title">Admin Login</h2>
    <p class="login-subtitle">Sign in to manage studio projects, reviews,<br>enquiries & vendors</p>

    <% if (error) { %>
      <div class="login-error">
        <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST" class="login-form">
      <div class="form-group">
        <label>EMAIL ADDRESS</label>
        <input type="email" name="email" value="admin@outsetstudio.in" required class="form-input">
      </div>

      <div class="form-group">
        <div class="label-row">
          <label>PASSWORD</label>
          <a href="#" class="forgot-link">Forgot Password?</a>
        </div>
        <div class="password-wrapper">
          <input type="password" name="password" id="password" value="admin123" required class="form-input">
          <button type="button" class="show-btn" onclick="togglePassword()">
            <i class="fa-regular fa-eye" id="eyeIcon"></i> SHOW
          </button>
        </div>
      </div>

      <div class="form-options">
        <label class="remember-label">
          <input type="checkbox" checked class="hidden-cb">
          <span class="custom-check"></span>
          <span>Remember this device</span>
        </label>
      </div>

      <button type="submit" class="login-btn">SIGN IN TO STUDIO ADMIN &nbsp;<i class="fa-solid fa-arrow-right"></i></button>

      <div class="login-divider"></div>
    </form>
  </div>
</div>

<script>
  function togglePassword() {
    const pw = document.getElementById('password');
    const icon = document.getElementById('eyeIcon');
    if (pw.type === 'password') {
      pw.type = 'text';
      icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
      pw.type = 'password';
      icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
  }
</script>
