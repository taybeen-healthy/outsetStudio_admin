<div class="page-header">
  <div class="page-breadcrumb breadcrumb-orange"><span class="bc-square"></span> STUDIO PROJECT <span class="bc-accent">• <%= project ? 'EDIT PROJECT' : 'NEW PROJECT' %></span></div>
  <div class="page-header-top">
    <div class="page-header-text">
      <h1 class="page-title"><%= project ? 'Edit Project' : 'New Project' %></h1>
      <p class="page-desc">Update project brief details, stage, progress and fee tracking for the studio pipeline.</p>
    </div>
    <a href="/admin/projects" class="save-btn save-btn-header" style="text-decoration:none;">&larr; Back to Projects</a>
  </div>
  <div class="page-divider"></div>
</div>

<div class="account-sections" style="max-width: 860px;">
  <div class="account-card">
    <div class="account-card-header">
      <h3 class="account-card-title">
        <i class="fa-solid fa-building"></i> Project Details
      </h3>
      <span class="account-badge"><%= project ? 'EDIT MODE' : 'DRAFT' %></span>
    </div>

    <form class="account-form" action="<%= project ? '/admin/projects/' + project._id : '/admin/projects' %>" method="POST">
      <% var isPortfolio = !!(project && project.type === 'portfolio'); %>
      <div class="form-grid-2">
        <div class="form-group">
          <label>Project Title *</label>
          <input type="text" name="title" value="<%= project ? project.title : '' %>" class="form-input" required>
        </div>
        <% if (isPortfolio) { %>
        <div class="form-group">
          <label>Subtitle (shown on website)</label>
          <input type="text" name="subtitle" value="<%= project ? (project.subtitle || '') : '' %>" class="form-input" placeholder="A thoughtfully crafted café experience...">
        </div>
        <% } else { %>
        <div class="form-group">
          <label>Project Code</label>
          <input type="text" name="code" value="<%= project ? (project.code || '') : '' %>" class="form-input" placeholder="#OS-DEL-01">
        </div>
        <% } %>
      </div>

      <% if (isPortfolio) { %>
      <div class="form-grid-2">
        <div class="form-group">
          <label>Location (website filter)</label>
          <input type="text" name="location" value="<%= project ? (project.location || '') : '' %>" class="form-input" placeholder="GURUGRAM">
        </div>
        <div class="form-group">
          <label>Card Image URL</label>
          <input type="text" name="image" value="<%= project ? (project.image || '') : '' %>" class="form-input" placeholder="/image39.png">
        </div>
      </div>

      <div class="form-group">
        <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
          <input type="checkbox" name="active" <%= !project || project.active !== false ? 'checked' : '' %> style="width:16px; height:16px; accent-color:#B84E29;">
          Published — visible on the public website (uncheck to hide)
        </label>
      </div>
      <% } else { %>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Client</label>
          <input type="text" name="client" value="<%= project ? (project.client || '') : '' %>" class="form-input">
        </div>
        <div class="form-group">
          <label>Location</label>
          <input type="text" name="location" value="<%= project ? (project.location || '') : '' %>" class="form-input" placeholder="Civil Lines, Delhi">
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Scale</label>
          <input type="text" name="scale" value="<%= project ? (project.scale || '') : '' %>" class="form-input" placeholder="6,500 sq.ft">
        </div>
        <div class="form-group">
          <label>Subtitle</label>
          <input type="text" name="subtitle" value="<%= project ? (project.subtitle || '') : '' %>" class="form-input" placeholder="Boutique Hotel • New Delhi">
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Status</label>
          <select name="status" class="form-input">
            <% statuses.forEach(function(s) { %>
              <option value="<%= s %>" <%= project && project.status === s ? 'selected' : (!project && s === 'Lead' ? 'selected' : '') %>><%= s %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>Progress (%)</label>
          <input type="number" name="progress" min="0" max="100" value="<%= project ? (project.progress || 0) : 0 %>" class="form-input">
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Fees (₹)</label>
          <input type="number" name="fees" min="0" value="<%= project ? (project.fees || 0) : 0 %>" class="form-input">
        </div>
        <div class="form-group">
          <label>Fee Status</label>
          <input type="text" name="feeStatus" value="<%= project ? (project.feeStatus || '') : '' %>" class="form-input" placeholder="DUE RETAINER / PAID FULL">
        </div>
      </div>
      <% } %>

      <div class="card-sep"></div>

      <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
        <button type="submit" class="save-btn">
          <i class="fa-solid fa-floppy-disk"></i> <%= project ? 'Save Changes' : 'Create Project' %>
        </button>
        <a href="/admin/projects" class="btn-muted" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px; padding:14px 22px;">Cancel</a>
        <% if (project) { %>
          <button type="submit" form="deleteProjectForm" class="btn-plain" style="margin-left:auto; color:#b3402a;"
                  onclick="return confirm('Delete this project permanently?')">
            <i class="fa-solid fa-trash"></i> Delete Project
          </button>
        <% } %>
      </div>
    </form>

    <% if (project) { %>
      <form id="deleteProjectForm" action="/admin/projects/<%= project._id %>/delete" method="POST"></form>
    <% } %>
  </div>
</div>
