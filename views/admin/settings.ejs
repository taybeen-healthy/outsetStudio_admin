<div class="page-header page-header-split">
  <div class="page-header-main">
    <div class="page-breadcrumb">ACCOUNT MANAGEMENT <span class="bc-accent">• <%= user.location.toUpperCase() %></span></div>
    <h1 class="page-title">Administrator Account</h1>
    <p class="page-desc">Manage administrative profile details and security credentials.</p>
  </div>
  <button type="submit" form="profileForm" class="save-btn save-btn-header">
    <i class="fa-solid fa-check"></i> Save Changes
  </button>
</div>

<div class="account-sections">
  <div class="account-card">
    <div class="account-card-header">
      <h3 class="account-card-title">
        <i class="fa-solid fa-user"></i> Profile Information
      </h3>
      <span class="account-badge">ADMIN PROFILE</span>
    </div>

    <div class="avatar-row">
      <div class="avatar-box">EV</div>
      <div class="avatar-details">
        <div class="avatar-title">Profile Avatar</div>
        <div class="avatar-subtitle">JPG, PNG or GIF. Max 2MB.</div>
        <div class="avatar-actions">
          <button type="button" class="btn-outline-sm">Change Avatar</button>
          <button type="button" class="btn-plain">Remove</button>
        </div>
      </div>
    </div>

    <div class="card-sep"></div>

    <form id="profileForm" class="account-form" action="/admin/settings/profile" method="POST">
      <div class="form-grid-2">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="name" value="Elena Vance" class="form-input">
        </div>
        <div class="form-group">
          <label>Professional Title / Role</label>
          <input type="text" name="title" value="Principal Director & Studio Admin" class="form-input">
        </div>
      </div>
      <div class="form-grid-2">
        <div class="form-group">
          <label>Contact Number</label>
          <input type="text" name="phone" value="+91 98988 44855" class="form-input">
        </div>
      </div>
      <div class="form-group">
        <label>Office / Studio Location</label>
        <input type="text" name="location" value="Delhi HQ" class="form-input">
      </div>

      <div class="card-sep"></div>

      <button type="submit" class="save-btn">
        <i class="fa-solid fa-floppy-disk"></i> Save Profile Changes
      </button>
    </form>
  </div>

  <div class="account-card">
    <div class="account-card-header">
      <h3 class="account-card-title">
        <i class="fa-solid fa-lock"></i> Security &amp; Password
      </h3>
      <span class="account-badge">CREDENTIALS</span>
    </div>

    <form class="account-form security-form" action="/admin/settings/password" method="POST">
      <div class="form-group">
        <label>Current Password</label>
        <input type="password" name="currentPassword" class="form-input" autocomplete="current-password">
      </div>
      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="newPassword" class="form-input" autocomplete="new-password">
        <div class="form-hint">Must be at least 8 characters with letters, numbers, and symbols.</div>
      </div>
      <div class="form-group">
        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" class="form-input" autocomplete="new-password">
      </div>

      <button type="submit" class="btn-muted">
        <i class="fa-solid fa-key"></i> Update Password
      </button>
    </form>
  </div>
</div>
