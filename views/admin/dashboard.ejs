<div class="page-header page-header-split">
  <div class="page-header-main">
    <div class="page-breadcrumb">STUDIO OPERATIONS OVERVIEW <span class="bc-accent">• FY 2024-25</span></div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-desc">Overview of studio enquiries, commissions, monthly delivery pace, and regional project velocity.</p>
  </div>
  <div class="page-date-card">
    <span class="date-dot"></span>
    STUDIO ACTIVE <span class="date-sep">•</span> <%= user.location.toUpperCase() %> <span class="date-sep">•</span> <span id="currentDate"></span>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-header">
      <span class="stat-label">TOTAL PROJECTS</span>
      <i class="fa-regular fa-building stat-icon"></i>
    </div>
    <div class="stat-number"><%= stats.totalProjects.toString().padStart(2, '0') %></div>
    <div class="stat-sublabel"><%= stats.totalProjectsLabel %></div>
    <div class="stat-footer">
      <span class="stat-highlight"><%= stats.totalProjectsHighlight %></span>
      <span class="stat-value orange"><%= stats.totalProjectsValue %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <span class="stat-label">NEW ENQUIRIES</span>
      <i class="fa-regular fa-pen-to-square stat-icon"></i>
    </div>
    <div class="stat-number orange"><%= stats.newEnquiries.toString().padStart(2, '0') %></div>
    <div class="stat-sublabel"><%= stats.newEnquiriesLabel %></div>
    <div class="stat-footer">
      <span class="stat-highlight"><%= stats.newEnquiriesHighlight %></span>
      <span class="stat-value"><%= stats.newEnquiriesValue %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <span class="stat-label">PENDING REVIEWS</span>
      <i class="fa-regular fa-square-check stat-icon"></i>
    </div>
    <div class="stat-number"><%= stats.pendingReviews.toString().padStart(2, '0') %></div>
    <div class="stat-sublabel"><%= stats.pendingReviewsLabel %></div>
    <div class="stat-footer">
      <span class="stat-highlight"><%= stats.pendingReviewsHighlight %></span>
      <span class="stat-value"><i class="fa-solid fa-star star-inline"></i> <%= stats.pendingReviewsValue %></span>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-header">
      <span class="stat-label">VENDOR REGISTRATIONS</span>
      <i class="fa-solid fa-user-plus stat-icon"></i>
    </div>
    <div class="stat-number"><%= stats.vendorRegistrations.toString().padStart(2, '0') %></div>
    <div class="stat-sublabel"><%= stats.vendorRegistrationsLabel %></div>
    <div class="stat-footer">
      <span class="stat-highlight"><%= stats.vendorRegistrationsHighlight %></span>
      <span class="stat-value"><%= stats.vendorRegistrationsValue %></span>
    </div>
  </div>
</div>

<div class="section-header">
  <span class="section-num">02</span>
  <div class="section-heading">
    <h2 class="section-title">Monthly Completed Projects</h2>
    <span class="section-sub">Month-by-month delivery volume &amp; completed site handovers</span>
  </div>
</div>
<div class="section-rule"></div>

<div class="chart-card">
  <div class="chart-card-top">
    <div class="chart-card-header">
      <div class="chart-card-meta">DELIVERY VELOCITY <span class="meta-dot">•</span> FY 2024-25</div>
      <div class="chart-card-title">Completed Site Handovers &amp; Commission Deliveries</div>
    </div>
    <div class="chart-legend">
      <span class="legend-item"><span class="legend-swatch delivered"></span> Delivered Projects</span>
      <span class="legend-item"><span class="legend-swatch pipeline"></span> Scheduled Pipeline</span>
    </div>
  </div>

  <div class="chart-body">
    <div class="chart-y-axis">
      <span>12</span>
      <span>9</span>
      <span>6</span>
      <span>3</span>
      <span>0</span>
    </div>
    <div class="chart-plot">
      <div class="chart-grid-lines">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="chart-bars">
        <% chart.months.forEach(function(m) { %>
          <div class="bar-col <%= m.active ? 'active' : '' %>">
            <div class="bar-track">
              <% if (m.estimate != null) { %>
                <div class="bar-estimate" style="bottom: <%= (m.estimate / chart.maxY) * 100 %>%">
                  <span class="estimate-label"><%= m.estimate %> (Est.)</span>
                  <span class="estimate-line"></span>
                </div>
              <% } %>
              <div class="bar-fill <%= m.type === 'pipeline' ? 'pipeline' : 'delivered' %>"
                   style="height: <%= (m.value / chart.maxY) * 100 %>%">
                <% if (m.active && m.badge) { %>
                  <div class="bar-badge"><%= m.badge %></div>
                <% } %>
              </div>
            </div>
            <div class="bar-label"><%= m.label %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="chart-footer">
    <span>Total Completed YTD: <%= chart.totalYtd %> Projects</span>
    <span class="chart-footer-sep">|</span>
    <span>Avg Monthly Delivery: <%= chart.avgMonthly %></span>
    <span class="chart-footer-sep">|</span>
    <span>On-Time Handover Rate: <%= chart.onTimeRate %></span>
  </div>
  <div class="chart-note">*Projected completions</div>
</div>

<script>
  const now = new Date();
  const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
  document.getElementById('currentDate').textContent = now.toLocaleDateString('en-US', options).toUpperCase();
</script>
