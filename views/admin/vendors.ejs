<% function escWbr(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }).replace(/[.@]/g, '$&<wbr>'); } %>
<div class="vr-header">
  <div class="vr-breadcrumb">
    <span class="vr-bc-num">04</span>
    <span class="vr-bc-dot">•</span>
    <span class="vr-bc-text">VENDOR EMBARKATION &amp; TRADE PARTNERS</span>
    <span class="vr-bc-sq"></span>
    <span class="vr-bc-admin">DELHI HQ ADMIN</span>
  </div>
  <h1 class="vr-title">Vendor Registrations</h1>
  <p class="vr-desc">Review, verify, and onboard trade specialists, material fabricators, and specialized artisanal contractors to the Outset Studio procurement network.</p>
</div>

<div class="vr-panel">
  <div class="vr-toolbar">
    <div class="vr-tabs">
      <% tabs.forEach(function(t) { %>
        <a href="/admin/vendors?status=<%= t.id %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="vr-tab <%= t.active ? 'active' : '' %>">
          <% if (t.badge) { %>
            <%= t.label %>
            <span class="vr-tab-badge"><%= t.count %></span>
          <% } else { %>
            <%= t.label %> (<%= t.count %>)
          <% } %>
        </a>
      <% }); %>
    </div>
    <form class="vr-loc-search" method="GET" action="/admin/vendors">
      <input type="hidden" name="status" value="<%= activeTab %>">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="q" value="<%= q || '' %>" placeholder="location...">
    </form>
  </div>

  <div class="table-scroll">
  <table class="vr-table">
    <thead>
      <tr>
        <th>VENDOR /<br>SPECIALIST</th>
        <th>REGISTERED</th>
        <th>CONTACT DETAILS</th>
        <th>TRADE &amp; SERVICES</th>
        <th>LOCATION</th>
        <th>ACTION</th>
      </tr>
    </thead>
    <tbody>
      <% if (vendors.length === 0) { %>
        <tr><td colspan="6" style="padding:28px;text-align:center;color:#999;">No vendors found<%= q ? ' for "' + q + '"' : '' %>.</td></tr>
      <% } %>
      <% vendors.forEach(function(v) { %>
        <tr>
          <td>
            <div class="vr-vendor-cell <%= v.highlight ? 'highlight' : '' %>">
              <div class="vr-vendor-name"><%= v.name %></div>
              <div class="vr-vendor-person"><%= v.founder %></div>
            </div>
          </td>
          <td><span class="vr-date"><%= v.registered %></span></td>
          <td>
            <div class="vr-contact-email"><%- escWbr(v.email) %></div>
            <div class="vr-contact-phone"><%= v.phone %></div>
          </td>
          <td><span class="vr-trade-chip"><%= v.trade %></span></td>
          <td><span class="vr-location"><%= v.location %></span></td>
          <td>
            <button class="vr-action-btn <%= v.action === 'REVIEW' ? 'review' : 'verify' %>"
                    data-vendor="<%= vendors.indexOf(v) %>">
              <%= v.action %>
            </button>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>

  <div class="vr-table-footer">
    <span class="vr-showing">Showing <%= showingFrom %>–<%= showingTo %> of <%= totalRegistrations %> registrations</span>
    <div class="vr-pagination">
      <% const vBase = 'status=' + activeTab + (q ? '&q=' + encodeURIComponent(q) : ''); %>
      <% if (page > 1) { %>
        <a class="vr-page-arrow" href="/admin/vendors?<%= vBase %>&page=<%= page - 1 %>">&lt;</a>
      <% } else { %>
        <button class="vr-page-arrow" disabled>&lt;</button>
      <% } %>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <a class="vr-page <%= p === currentPage ? 'active' : '' %>" href="/admin/vendors?<%= vBase %>&page=<%= p %>"><%= p %></a>
      <% } %>
      <% if (page < totalPages) { %>
        <a class="vr-page-arrow" href="/admin/vendors?<%= vBase %>&page=<%= page + 1 %>">&gt;</a>
      <% } else { %>
        <button class="vr-page-arrow" disabled>&gt;</button>
      <% } %>
    </div>
  </div>
</div>

<% vendors.forEach(function(v, idx) { %>
<div class="vr-modal-overlay" id="vr-modal-<%= idx %>" style="display:none;">
  <div class="vr-modal">
    <div class="vr-modal-scroll">
      <div class="vr-modal-head">
        <div class="vr-modal-breadcrumb">
          <span class="vr-bc-num">04.1</span>
          <span class="vr-bc-dot">•</span>
          <span class="vr-bc-text">TRADE COMPLIANCE &amp; ONBOARDING DOSSIER</span>
          <span class="vr-bc-sq"></span>
          <span class="vr-bc-admin">DELHI HQ ARCHIVAL</span>
        </div>
        <button class="vr-modal-close" data-close="<%= idx %>">&times;</button>
        <h2 class="vr-modal-title">Review Vendor Registration</h2>
        <p class="vr-modal-desc">Scrutiny and verification protocol for architectural fabricators, artisans, and materials contractors</p>
      </div>

      <div class="vr-modal-divider"></div>

      <div class="vr-modal-grid">
        <div class="vr-modal-left">
          <div class="vr-meta-row">
            <div class="vr-meta-left">
              <span class="vr-ven-id">#<%= v.id %></span>
              <span class="vr-status-dot">●</span>
              <span class="vr-status-badge"><%= v.status %></span>
            </div>
            <div class="vr-meta-right">
              <div class="vr-submission-label">SUBMISSION DATE</div>
              <div class="vr-submission-date"><%= v.submissionDate %></div>
              <div class="vr-submission-time"><%= v.submissionTime %></div>
            </div>
          </div>

          <h3 class="vr-vendor-fullname"><%= v.fullName %></h3>
          <p class="vr-vendor-founder"><%= v.founderTitle %>: <strong><%= v.founder %></strong></p>

          <div class="vr-info-cards">
            <div class="vr-info-card">
              <div class="vr-info-label">PRIMARY CONTACT</div>
              <div class="vr-info-phone"><%= v.phone %></div>
              <div class="vr-info-email"><%- escWbr(v.email) %></div>
            </div>
            <div class="vr-info-card">
              <div class="vr-info-label">REGIONAL WORKSHOP</div>
              <div class="vr-info-address"><% v.workshop.forEach(function(line, i) { %><%= line %><% if (i < v.workshop.length - 1) { %><br><% } %><% }); %></div>
            </div>
          </div>

          <div class="vr-section-block">
            <div class="vr-section-label">TAX &amp; LEGAL VERIFICATION</div>
            <div class="vr-tax-grid">
              <div class="vr-tax-item">
                <div class="vr-tax-key">GSTIN Registration</div>
                <div class="vr-tax-val-row">
                  <span class="vr-tax-val"><%= v.gstin %></span>
                  <% if (v.gstinVerified) { %>
                    <span class="vr-verified-badge"><i class="fa-solid fa-circle-check"></i> VERIFIED PORTAL</span>
                  <% } %>
                </div>
              </div>
              <div class="vr-tax-item">
                <div class="vr-tax-key">MSME / Udyam Registry</div>
                <div class="vr-tax-val-row">
                  <span class="vr-tax-val"><%= v.msme %></span>
                  <span class="vr-tax-note">(<%= v.msmeNote %>)</span>
                </div>
              </div>
            </div>
          </div>

          <div class="vr-section-block">
            <div class="vr-section-label">CAPABILITIES &amp; TRADE SCOPE</div>
            <div class="vr-capability-tags">
              <% v.capabilities.forEach(function(c) { %>
                <span class="vr-capability-tag"><%= c %></span>
              <% }); %>
            </div>
          </div>

          <div class="vr-capacity-card">
            <div class="vr-capacity-head">
              <span class="vr-section-label">CAPACITY &amp; GUILD RESOURCES</span>
              <span class="vr-capacity-stats"><%= v.capacityStats.join(' • ') %></span>
            </div>
            <div class="vr-files-grid">
              <% v.files.forEach(function(f) { %>
                <div class="vr-file-row">
                  <div class="vr-file-left">
                    <i class="fa-solid <%= f.icon %> vr-file-icon"></i>
                    <div class="vr-file-meta">
                      <div class="vr-file-name"><%= f.name %></div>
                      <div class="vr-file-size"><%= f.size %></div>
                    </div>
                  </div>
                  <button class="vr-file-dl"><i class="fa-solid fa-download"></i></button>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="vr-modal-right">
          <h3 class="vr-checklist-title">Internal Verification Checklist</h3>
          <p class="vr-checklist-desc">Studio compliance and archival clearance steps before active project assignment.</p>

          <div class="vr-checklist">
            <% v.checklist.forEach(function(item, ci) { %>
              <form action="/admin/vendors/<%= v.docId %>/checklist" method="POST" class="vr-check-form">
                <input type="hidden" name="index" value="<%= ci %>">
                <input type="hidden" name="tab" value="<%= activeTab %>">
                <input type="hidden" name="q" value="<%= q || '' %>">
                <label class="vr-check-item <%= item.checked ? 'checked' : '' %>">
                  <input type="checkbox" class="vr-check-input" name="checked" <%= item.checked ? 'checked' : '' %>>
                  <span class="vr-check-box"></span>
                  <span class="vr-check-text">
                    <span class="vr-check-title"><%= item.title %></span>
                    <span class="vr-check-sub"><%= item.desc %></span>
                  </span>
                </label>
              </form>
            <% }); %>
          </div>

          <div class="vr-curator-card">
            <div class="vr-curator-head">
              <span class="vr-curator-label">ASSIGNED LEAD CURATOR</span>
              <span class="vr-curator-tier"><%= v.curator.tier %></span>
            </div>
            <div class="vr-curator-body">
              <i class="fa-solid fa-user-tie vr-curator-icon"></i>
              <div>
                <div class="vr-curator-name"><%= v.curator.name %></div>
                <div class="vr-curator-role"><%= v.curator.role %></div>
              </div>
            </div>
          </div>

          <div class="vr-remarks-block">
            <div class="vr-remarks-label">CURATOR REMARKS / AUDIT NOTES</div>
            <form action="/admin/vendors/<%= v.docId %>/remarks" method="POST">
              <input type="hidden" name="tab" value="<%= activeTab %>">
              <input type="hidden" name="q" value="<%= q || '' %>">
              <textarea class="vr-remarks-input" name="remarks" rows="4"><%= v.remarks %></textarea>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="vr-modal-footer">
      <form action="/admin/vendors/<%= v.docId %>/status" method="POST" style="display:contents;">
        <input type="hidden" name="tab" value="<%= activeTab %>">
        <button class="vr-btn-request" type="submit" name="status" value="UNDER SCRUTINY">REQUEST ADDITIONAL SAMPLES / AUDIT</button>
        <div class="vr-modal-footer-right">
          <button class="vr-btn-decline" type="submit" name="status" value="ARCHIVED">DECLINE REGISTRATION</button>
          <button class="vr-btn-approve" type="submit" name="status" value="APPROVED"><i class="fa-solid fa-circle-check"></i> APPROVE &amp; ONBOARD TO VENDOR GUILD</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% }); %>

<script>
  document.querySelectorAll('.vr-action-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = 'vr-modal-' + btn.getAttribute('data-vendor');
      var modal = document.getElementById(id);
      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  document.querySelectorAll('.vr-modal-close').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var modal = document.getElementById('vr-modal-' + btn.getAttribute('data-close'));
      if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
  });

  document.querySelectorAll('.vr-modal-overlay').forEach(function(overlay) {
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
      }
    });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.vr-modal-overlay').forEach(function(m) {
        m.style.display = 'none';
      });
      document.body.style.overflow = '';
    }
  });

  function vrPost(url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: new URLSearchParams(data).toString(),
      redirect: 'manual'
    }).then(function(res) {
      if (res.status === 0 || res.type === 'opaqueredirect') return { ok: true };
      return res.json().then(function(j) { return res.ok && j.ok !== false ? j : { ok: false }; });
    });
  }

  function vrToast(title, msg, isError) {
    var old = document.getElementById('vrLiveToast');
    if (old) old.remove();
    var t = document.createElement('div');
    t.className = 'status-toast';
    t.id = 'vrLiveToast';
    t.innerHTML = '<i class="fa-solid ' + (isError ? 'fa-triangle-exclamation' : 'fa-circle-check') + ' toast-icon" style="color:' + (isError ? '#f87171' : '#4ade80') + '"></i>' +
      '<div class="toast-body"><div class="toast-title"></div><div class="toast-msg"></div></div>' +
      '<button type="button" class="toast-close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>';
    t.querySelector('.toast-title').textContent = title;
    t.querySelector('.toast-msg').textContent = msg;
    document.body.appendChild(t);
    var timer = setTimeout(function() { t.classList.add('toast-hide'); }, 4000);
    t.querySelector('.toast-close').addEventListener('click', function() {
      clearTimeout(timer);
      t.classList.add('toast-hide');
    });
  }

  document.querySelectorAll('.vr-check-input').forEach(function(input) {
    input.addEventListener('change', function() {
      var form = input.closest('form');
      var label = input.closest('.vr-check-item');
      if (!form || !label) return;
      var prev = label.classList.contains('checked');
      label.classList.toggle('checked', input.checked);
      var entries = {};
      new FormData(form).forEach(function(val, key) { entries[key] = val; });
      vrPost(form.action, entries).then(function(j) {
        if (j && j.ok) {
          if (typeof j.checked === 'boolean') {
            input.checked = j.checked;
            label.classList.toggle('checked', j.checked);
          }
        } else {
          input.checked = prev;
          label.classList.toggle('checked', prev);
          vrToast('Update Failed', 'Could not save checklist.', true);
        }
      }).catch(function() {
        input.checked = prev;
        label.classList.toggle('checked', prev);
        vrToast('Update Failed', 'Could not save checklist.', true);
      });
    });
  });

  document.querySelectorAll('.vr-remarks-input').forEach(function(ta) {
    ta.addEventListener('change', function() {
      var form = ta.closest('form');
      if (!form) return;
      var entries = {};
      new FormData(form).forEach(function(val, key) { entries[key] = val; });
      vrPost(form.action, entries).then(function(j) {
        if (j && j.ok) vrToast('Remarks Saved', 'Curator remarks have been saved.');
        else vrToast('Update Failed', 'Could not save remarks.', true);
      }).catch(function() {
        vrToast('Update Failed', 'Could not save remarks.', true);
      });
    });
  });
</script>
