<div class="page-header reviews-header">
  <div class="reviews-header-row">
    <div class="reviews-header-info">
      <div class="page-breadcrumb breadcrumb-orange">EDITORIAL CURATION • PUBLIC TESTIMONIALS</div>
      <h1 class="page-title">Client Reviews</h1>
      <p class="page-desc">Moderate and approve client feedback before it is published on the Outset Studio public website.</p>
    </div>
    <div class="review-filters">
      <button type="button" class="review-filter-btn active" data-filter="all">
        <span class="rf-label">ALL</span>
        <span class="rf-count">(<%= counts.all %>)</span>
      </button>
      <button type="button" class="review-filter-btn" data-filter="pending">
        <span class="rf-label">PENDING</span>
        <span class="rf-count">(<%= counts.pending %>)</span>
      </button>
      <button type="button" class="review-filter-btn" data-filter="approved">
        <span class="rf-label">APPROVED</span>
        <span class="rf-count">(<%= counts.approved %>)</span>
      </button>
      <button type="button" class="review-filter-btn" data-filter="declined">
        <span class="rf-label">DECLINED</span>
        <span class="rf-count">(<%= counts.declined %>)</span>
      </button>
    </div>
  </div>
</div>

<% if (toast) { %>
  <div class="status-toast" id="statusToast">
    <i class="fa-solid fa-circle-check toast-icon"></i>
    <div class="toast-body">
      <div class="toast-title"><%= toast.title %></div>
      <div class="toast-msg"><%= toast.msg %></div>
    </div>
    <button type="button" class="toast-close" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
  </div>
<% } %>

<div class="table-container reviews-table-wrap">
  <table class="data-table reviews-table">
    <thead>
      <tr>
        <th>CLIENT &amp; COMPANY</th>
        <th>PROJECT / TYPOLOGY</th>
        <th>TESTIMONIAL</th>
        <th>DATE</th>
        <th class="th-right">ACTIONS</th>
      </tr>
    </thead>
    <tbody>
      <% reviews.forEach(function(r) { %>
        <tr class="review-row" data-status="<%= r.status %>">
          <td>
            <div class="review-client-cell">
              <span class="review-avatar avatar-<%= r.avatar %>"><%= r.initials %></span>
              <div class="review-client-info">
                <div class="review-client-name"><%= r.name %></div>
                <div class="review-client-company"><%= r.company %></div>
              </div>
            </div>
          </td>
          <td>
            <div class="review-project-name"><%= r.project %></div>
            <div class="review-typology"><%= r.typology %></div>
          </td>
          <td>
            <div class="review-testimonial">"<%= r.text %>"</div>
          </td>
          <td>
            <div class="review-date"><%= r.date %></div>
          </td>
          <td class="td-actions">
            <div class="action-buttons">
              <form method="POST" action="/admin/reviews/<%= r.id %>/status">
                <input type="hidden" name="status" value="approved">
                <button type="submit" class="approve-btn">APPROVE</button>
              </form>
              <form method="POST" action="/admin/reviews/<%= r.id %>/status">
                <input type="hidden" name="status" value="declined">
                <button type="submit" class="decline-btn">DECLINE</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<script>
  (function () {
    var toast = document.getElementById('statusToast');
    if (toast) {
      var hideTimer = setTimeout(function () { toast.classList.add('toast-hide'); }, 6000);
      toast.querySelector('.toast-close').addEventListener('click', function () {
        clearTimeout(hideTimer);
        toast.classList.add('toast-hide');
      });
    }

    var filterBtns = document.querySelectorAll('.review-filter-btn');
    var rows = document.querySelectorAll('.review-row');
    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var filter = btn.getAttribute('data-filter');
        rows.forEach(function (row) {
          var status = row.getAttribute('data-status');
          row.style.display = (filter === 'all' || status === filter) ? '' : 'none';
        });
      });
    });
  })();
</script>
