<div class="page-header projects-header">
  <div class="page-breadcrumb breadcrumb-orange"><span class="bc-square"></span> STUDIO PROJECT</div>
  <div style="display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <h1 class="page-title" style="margin:0;">Projects</h1>
    <button type="button" class="save-btn" id="openAddProject" style="border:none; cursor:pointer;">
      <i class="fa-solid fa-plus"></i> Add Project
    </button>
  </div>
  <p class="page-desc projects-desc">Manage active architectural briefs, site surveys, turnkey execution tranches, vendor disbursements, and archival sign-offs across Indian metropolitan practices.</p>
</div>

<div class="table-container projects-table-wrap">
  <table class="data-table projects-table">
    <thead>
      <tr>
        <th>PROJECT &amp; CLIENT</th>
        <th>LOCATION / SCALE</th>
        <th>STATUS</th>
        <th>PROGRESS</th>
        <th class="th-right">FEES</th>
      </tr>
    </thead>
    <tbody>
      <% if (projects.length === 0) { %>
        <tr><td colspan="5" style="padding:28px;text-align:center;color:#999;">No projects found.</td></tr>
      <% } %>
      <% projects.forEach(function(p) { %>
        <tr>
          <td>
            <div class="project-name-row">
              <a href="/admin/projects/<%= p.id %>/edit" class="project-name" style="color:inherit; text-decoration:none;"><%= p.name %></a>
              <span class="project-code-chip"><%= p.code %></span>
            </div>
            <div class="client-name-sm"><%= p.client %></div>
          </td>
          <td>
            <div class="loc-primary"><%= p.location %></div>
            <div class="loc-scale"><%= p.scale %></div>
          </td>
          <td>
            <span class="status-pill status-<%= p.statusClass %>"><%= p.status %></span>
          </td>
          <td>
            <div class="progress-cell">
              <div class="progress-bar"><div class="progress-fill" style="width: <%= p.progress %>%"></div></div>
              <span class="progress-text"><%= p.progress %>%</span>
            </div>
          </td>
          <td class="td-fees">
            <div class="fee-amount <%= p.feeClass %>"><%= p.fees %></div>
            <div class="fee-status"><%= p.feeStatus %></div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="enq-table-footer">
    <div class="enq-showing">
      <span>Showing <%= showingFrom %>–<%= showingTo %> of <%= total %> projects</span>
    </div>
    <div class="enq-pagination">
      <% if (page > 1) { %>
        <a class="enq-page-btn" href="/admin/projects?page=<%= page - 1 %>">Prev</a>
      <% } else { %>
        <button class="enq-page-btn" type="button" disabled>Prev</button>
      <% } %>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <a class="enq-page-btn <%= p === page ? 'active' : '' %>" href="/admin/projects?page=<%= p %>"><%= p %></a>
      <% } %>
      <% if (page < totalPages) { %>
        <a class="enq-page-btn" href="/admin/projects?page=<%= page + 1 %>">Next</a>
      <% } else { %>
        <button class="enq-page-btn" type="button" disabled>Next</button>
      <% } %>
    </div>
  </div>
</div>

<div class="vr-modal-overlay" id="addProjectModal" style="display:none;">
  <div class="vr-modal" style="max-width:760px;">
    <div class="vr-modal-scroll">
      <div class="vr-modal-head">
        <button class="vr-modal-close" type="button" data-close-modal>&times;</button>
        <div class="page-breadcrumb breadcrumb-orange" style="margin-bottom:10px;"><span class="bc-square"></span> STUDIO PROJECT <span class="bc-accent">• NEW ENTRY</span></div>
        <h2 class="vr-modal-title">Add Project</h2>
        <p class="vr-modal-desc">Projects are added to the website portfolio and appear on the public site within 60 seconds.</p>
      </div>

      <div class="vr-modal-divider"></div>

      <form id="addProjectForm" method="POST" action="/admin/projects" class="account-form">
        <div class="form-grid-2">
          <div class="form-group">
            <label>Name *</label>
            <input type="text" name="title" class="form-input" required placeholder="Project name">
          </div>
          <div class="form-group">
            <label>Location</label>
            <input type="text" name="location" class="form-input" placeholder="GURUGRAM / Civil Lines, Delhi">
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-group">
            <label>Price (&#8377;)</label>
            <input type="number" name="fees" min="0" class="form-input" placeholder="450000">
          </div>
          <div class="form-group">
            <label>Sq. Ft.</label>
            <input type="text" name="scale" class="form-input" placeholder="6,500 sq.ft">
          </div>
        </div>
      </form>
    </div>

    <div class="vr-modal-footer">
      <span class="vr-modal-desc" style="max-width:none; margin:0;">Add images, specs and description later from Edit.</span>
      <div class="vr-modal-footer-right">
        <button type="button" class="btn-muted" data-close-modal style="padding:13px 22px; cursor:pointer; background:none;">Cancel</button>
        <button type="submit" form="addProjectForm" class="save-btn" style="border:none; cursor:pointer;">
          <i class="fa-solid fa-floppy-disk"></i> Create Project
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var overlay = document.getElementById('addProjectModal');
    var openBtn = document.getElementById('openAddProject');

    openBtn.addEventListener('click', function () {
      overlay.style.display = 'flex';
    });
    overlay.querySelectorAll('[data-close-modal]').forEach(function (btn) {
      btn.addEventListener('click', function () { overlay.style.display = 'none'; });
    });
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) overlay.style.display = 'none';
    });
  })();
</script>
