<div class="page-header projects-header">
  <div class="page-breadcrumb breadcrumb-orange"><span class="bc-square"></span> STUDIO PROJECT</div>
  <h1 class="page-title">Projects</h1>
  <p class="page-desc projects-desc">Manage active architectural briefs, site surveys, turnkey execution tranches, vendor disbursements, and archival sign-offs across Indian metropolitan practices.</p>
</div>

<div class="review-filters" style="margin-bottom:18px; display:flex; width:fit-content; border:1px solid var(--border, #e5e5e5);">
  <a href="/admin/projects?view=pipeline" class="review-filter-btn <%= view === 'pipeline' ? 'active' : '' %>" style="text-decoration:none; display:flex; flex-direction:row; align-items:center; gap:6px;">PIPELINE (<%= pipelineCount %>)</a>
  <a href="/admin/projects?view=portfolio" class="review-filter-btn <%= view === 'portfolio' ? 'active' : '' %>" style="text-decoration:none; display:flex; flex-direction:row; align-items:center; gap:6px;">PORTFOLIO (<%= portfolioCount %>)</a>
</div>

<div class="table-container projects-table-wrap">
  <table class="data-table projects-table">
    <thead>
      <tr>
        <th>PROJECT &amp; CLIENT</th>
        <th>LOCATION / SCALE</th>
        <th>STATUS</th>
        <th>PROGRESS</th>
        <th class="th-right">FEES</th>
      </tr>
    </thead>
    <tbody>
      <% if (projects.length === 0) { %>
        <tr><td colspan="5" style="padding:28px;text-align:center;color:#999;"><%= view === 'portfolio' ? 'No portfolio projects yet.' : 'No projects found.' %></td></tr>
      <% } %>
      <% projects.forEach(function(p) { %>
        <tr>
          <td>
            <div class="project-name-row">
              <a href="/admin/projects/<%= p.id %>/edit" class="project-name" style="color:inherit; text-decoration:none;"><%= p.name %></a>
              <span class="project-code-chip"><%= p.code %></span>
            </div>
            <div class="client-name-sm"><%= p.client %></div>
          </td>
          <td>
            <div class="loc-primary"><%= p.location %></div>
            <div class="loc-scale"><%= p.scale %></div>
          </td>
          <td>
            <span class="status-pill status-<%= p.statusClass %>"><%= p.status %></span>
          </td>
          <td>
            <div class="progress-cell">
              <div class="progress-bar"><div class="progress-fill" style="width: <%= p.progress %>%"></div></div>
              <span class="progress-text"><%= p.progress %>%</span>
            </div>
          </td>
          <td class="td-fees">
            <div class="fee-amount <%= p.feeClass %>"><%= p.fees %></div>
            <div class="fee-status"><%= p.feeStatus %></div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
