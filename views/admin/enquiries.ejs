<div class="page-header">
  <div class="page-breadcrumb"><span class="bc-square"></span> INBOUND CLIENT COMMISSIONS <span class="bc-accent">• STUDIO ARCHIVAL LOG / OUTSET STUDIO • DELHI HQ ADMIN</span></div>
  <h1 class="page-title">Recent Enquiries</h1>
  <p class="page-desc enq-page-desc">Review, evaluate, and qualify incoming retail, café, hospitality, and residential architecture enquiries across Indian metropolitan studios.</p>
</div>

<div class="enquiries-layout">
  <div class="enq-main">
    <div class="enq-card">
      <div class="enq-toolbar">
        <div class="enq-tabs">
          <% tabs.forEach(function(t) { %>
            <a href="/admin/enquiries?status=<%= t.key %>" class="enq-tab <%= activeTab === t.key ? 'active' : '' %>"><%= t.label %></a>
          <% }); %>
        </div>
        <div class="enq-toolbar-right">
          <form class="enq-filter-search" method="GET" action="/admin/enquiries">
            <input type="hidden" name="status" value="<%= activeTab %>">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" name="q" value="<%= q || '' %>" placeholder="Filter by client name, city...">
          </form>
          <div class="enq-view-toggle">
            <button class="enq-view-btn active" type="button" data-view="list" title="List view"><i class="fa-solid fa-list-ul"></i></button>
            <button class="enq-view-btn" type="button" data-view="grid" title="Grid view"><i class="fa-solid fa-table-cells-large"></i></button>
          </div>
        </div>
      </div>

      <table class="data-table enq-table">
        <thead>
          <tr>
            <th>CLIENT NAME</th>
            <th>PROJECT / SERVICE</th>
            <th>DATE LOGGED</th>
            <th>LOCATION</th>
          </tr>
        </thead>
        <tbody>
          <% if (enquiries.length === 0) { %>
            <tr><td colspan="4" style="padding:28px;text-align:center;color:#999;">No enquiries found<%= q ? ' for "' + q + '"' : '' %>.</td></tr>
          <% } %>
          <% enquiries.forEach(function(e) { %>
            <tr class="<%= selected && String(selected.id) === String(e.id) ? 'selected' : '' %>" onclick="window.location='/admin/enquiries?status=<%= activeTab %>&id=<%= e.id %><%= q ? '&q=' + encodeURIComponent(q) : '' %>'">
              <td>
                <div class="client-name"><%= e.name %></div>
                <div class="client-email"><%= e.email || '' %></div>
              </td>
              <td>
                <div class="service-name"><%= e.service || e.typology || '—' %></div>
                <div class="service-scope"><%= e.scope || e.message || '' %></div>
              </td>
              <td><span class="date-text"><%= e.date %></span></td>
              <td><span class="location-text"><i class="fa-solid fa-location-dot"></i> <%= e.location || '—' %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="enq-grid">
        <% if (enquiries.length === 0) { %>
          <div class="enq-grid-empty">No enquiries found<%= q ? ' for "' + q + '"' : '' %>.</div>
        <% } %>
        <% enquiries.forEach(function(e) { %>
          <a class="enq-grid-card <%= selected && String(selected.id) === String(e.id) ? 'selected' : '' %>"
             href="/admin/enquiries?status=<%= activeTab %>&id=<%= e.id %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
            <div class="enq-grid-top">
              <div>
                <div class="client-name"><%= e.name %></div>
                <div class="client-email"><%= e.email || '' %></div>
              </div>
              <span class="date-text"><%= e.date %></span>
            </div>
            <div class="service-name"><%= e.service || e.typology || '—' %></div>
            <div class="service-scope"><%= e.scope || e.message || '' %></div>
            <div class="enq-grid-foot"><i class="fa-solid fa-location-dot"></i> <%= e.location || '—' %></div>
          </a>
        <% }); %>
      </div>

      <div class="enq-table-footer">
        <div class="enq-showing">
          <span>Showing <%= showingFrom %>–<%= showingTo %> of <%= total %> enquiries</span>
          <span class="enq-showing-sep">•</span>
          <strong>ARCHIVAL BATCH #2026–Q3</strong>
        </div>
        <div class="enq-pagination">
          <% const baseQs = 'status=' + activeTab + (q ? '&q=' + encodeURIComponent(q) : ''); %>
          <% if (page > 1) { %>
            <a class="enq-page-btn" href="/admin/enquiries?<%= baseQs %>&page=<%= page - 1 %>">Prev</a>
          <% } else { %>
            <button class="enq-page-btn" type="button" disabled>Prev</button>
          <% } %>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a class="enq-page-btn <%= p === page ? 'active' : '' %>" href="/admin/enquiries?<%= baseQs %>&page=<%= p %>"><%= p %></a>
          <% } %>
          <% if (page < totalPages) { %>
            <a class="enq-page-btn" href="/admin/enquiries?<%= baseQs %>&page=<%= page + 1 %>">Next</a>
          <% } else { %>
            <button class="enq-page-btn" type="button" disabled>Next</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <aside class="enq-detail">
    <% if (!selected) { %>
      <div class="enq-detail-body">
        <div class="enq-section-label">NO ENQUIRY SELECTED</div>
        <div class="enq-brief">Select an enquiry from the list to view its full brief and take action.</div>
      </div>
    <% } else { %>
    <div class="enq-detail-head">
      <span class="enq-ref"><span class="enq-ref-dot"></span><%= selected.ref %></span>
      <span class="enq-status-badge"><%= selected.status %></span>
    </div>

    <div class="enq-detail-body">
      <div class="enq-section-label">CLIENT &amp; ORGANIZATION</div>
      <div class="enq-client-name"><%= selected.name %></div>
      <div class="enq-client-org"><%= selected.org %></div>

      <div class="enq-facts">
        <div class="enq-fact">
          <div class="enq-fact-label">TYPOLOGY</div>
          <div class="enq-fact-value"><%= selected.typology %></div>
        </div>
        <div class="enq-fact">
          <div class="enq-fact-label">FOOTPRINT</div>
          <div class="enq-fact-value"><%= selected.footprint %></div>
        </div>
        <div class="enq-fact enq-fact-wide">
          <div class="enq-fact-label">BUDGET ESTIMATE</div>
          <div class="enq-fact-budget"><%= selected.budget %></div>
        </div>
      </div>

      <div class="enq-section-label">SITE CONSTRAINTS &amp; BRIEF</div>
      <div class="enq-brief">"<%= selected.brief %>"</div>

      <div class="enq-section-label">COMMUNICATION CHANNELS</div>
      <ul class="enq-channels">
        <li><i class="fa-regular fa-envelope"></i><span><%= selected.email %></span></li>
        <li><i class="fa-solid fa-phone"></i><span><%= selected.phone %></span></li>
        <li><i class="fa-solid fa-location-dot"></i><span><%= selected.address %></span></li>
      </ul>

      <div class="enq-assignee">
        <div class="enq-assignee-info">
          <span class="enq-assignee-avatar"><%= selected.assignee.initials %></span>
          <div>
            <div class="enq-assignee-name"><%= selected.assignee.name %></div>
            <div class="enq-assignee-role"><%= selected.assignee.role %></div>
          </div>
        </div>
        <form action="/admin/enquiries/<%= selected.id %>/assign" method="POST" style="display:inline;">
          <input type="hidden" name="tab" value="<%= activeTab %>">
          <button class="enq-assign-btn" type="submit">ASSIGN</button>
        </form>
      </div>

      <form action="/admin/enquiries/<%= selected.id %>/status" method="POST">
        <input type="hidden" name="tab" value="<%= activeTab %>">
        <% if (selected.status === 'NEW') { %>
          <button class="enq-survey-btn" type="submit" name="status" value="IN DISCUSSION"><i class="fa-solid fa-arrow-up"></i> INITIATE SITE SURVEY</button>
        <% } %>
        <div class="enq-action-row">
          <button class="enq-action-btn" type="submit" name="status" value="IN DISCUSSION">Mark Discussion</button>
          <button class="enq-action-btn danger" type="submit" name="status" value="ARCHIVED">Decline / Archive</button>
        </div>
      </form>
    </div>

    <div class="enq-detail-foot">
      <span><strong>LOGGED:</strong> <%= selected.logged %></span>
      <span><strong>IP:</strong> <%= selected.ip %></span>
    </div>
    <% } %>
  </aside>
</div>

<script>
(function () {
  var table = document.querySelector('.enq-table');
  var grid = document.querySelector('.enq-grid');
  var btns = document.querySelectorAll('.enq-view-btn');
  if (!table || !grid) return;
  function apply(view) {
    var gridOn = view === 'grid';
    table.classList.toggle('hide', gridOn);
    grid.classList.toggle('show', gridOn);
    btns.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-view') === view); });
    try { localStorage.setItem('enqView', view); } catch (e) {}
  }
  var saved = 'list';
  try { saved = localStorage.getItem('enqView') || 'list'; } catch (e) {}
  btns.forEach(function (b) {
    b.addEventListener('click', function () { apply(b.getAttribute('data-view')); });
  });
  apply(saved);
})();
</script>
